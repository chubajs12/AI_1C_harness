# Параметры проекта для скриптов комплекта. Скопировать в config/project.env.local и заполнить.
# project.env.local в git не попадает (пароль базы). Формат: КЛЮЧ=значение, без кавычек, без подстановок.

# --- Проект ---
PROJECT=myproj
# Префикс новых объектов расширения и новых процедур (п. 1.5 AGENTS.md)
PREFIX=пр_
# Каталог этого комплекта (настройки агента) и каталог сырцов 1С
PROJECT_ROOT=F:\AI_Claude\myproj
SRC_ROOT=F:\AI_Claude\myproj_src
CONF_DIR=F:\AI_Claude\myproj_src\conf
EXT_DIR=F:\AI_Claude\myproj_src\ext
BUILD_DIR=F:\AI_Claude\myproj_src\build
# Имя бинарника расширения латиницей: <PROJECT>_<EXT_FILE_NAME>_vX_Y_Z.cfe
EXT_FILE_NAME=EXT

# --- Платформа и база ---
PLATFORM=C:\Program Files\1cv8\8.3.27.1936\bin\1cv8.exe
PLATFORM_THIN=C:\Program Files\1cv8\8.3.27.1936\bin\1cv8c.exe
# Клиент-серверная база: сервер кластера и имя базы (Srvr / Ref). Файловая база — INFOBASE_FILE вместо них.
INFOBASE_SERVER=chubajs12
INFOBASE_REF=myproj
INFOBASE_FILE=
USER=MCPUser
PASS=<пароль пользователя базы>
# Расширение, которое дорабатываем
EXTENSION_NAME=<ИмяРасширения>

# --- MCP 1С: основной канал агента в живую базу (docs/03) ---
# HTTP-сервис расширения MCP_Сервер на IIS: http://127.0.0.1:<MCP1C_PORT>/<MCP1C_APP>/hs/mcp, вход — Basic USER/PASS
# (пользователь с правом «Администрирование»: только он выполняет execute_code без безопасного режима).
MCP1C_PORT=8095
# Имя приложения IIS (по умолчанию — INFOBASE_REF)
MCP1C_APP=myproj
# Сайт IIS (может быть общим с другими проектами) и его каталог
MCP1C_SITE=1c_mcp
MCP1C_IIS_ROOT=C:\inetpub\1c_mcp
# Пул приложений — свой у проекта на версию платформы (пусто — 1c_mcp_<PROJECT>_<версия платформы>)
MCP1C_POOL=
# autouse — сеансы публикации переиспользуются (быстро, но кэш сеанса ~20 с); dontuse — новый сеанс на каждый вызов
MCP1C_REUSE_SESSIONS=autouse
# Дистрибутив: MCP_Сервер_v*.cfe, MCP_ВыполнениеКода_v*.cfe, MCP_Установщик_v*.epf
MCP1C_DIST=F:\AI_Claude\myproj\tools\mcp1c
# Канал скриптов в базу: mcp1c (основной) | onebridge (запасной, docs/09)
DB_CHANNEL=mcp1c
# RAS для rac (сеансы кластера): порт временного ras.exe и адрес агента кластера
RAS_PORT=1545
CLUSTER=localhost:1540

# --- OneBridge — запасной канал (docs/09), только при DB_CHANNEL=onebridge ---
ONEBRIDGE_EPF=F:\AI_Claude\myproj\tools\onebridge\OneBridge.epf
ONEBRIDGE_PORT=1440

# --- Vanessa Automation ---
VANESSA_ROOT=F:\AI_Claude\myproj\tools\vanessa
VANESSA_EPF=F:\AI_Claude\myproj\tools\vanessa\single\vanessa-automation-single.epf
VANESSA_VAPARAMS=F:\AI_Claude\myproj\tools\vanessa\VAParams.json
VANESSA_FEATURES=F:\AI_Claude\myproj\tools\vanessa\features
VANESSA_REPORTS=F:\AI_Claude\myproj\tools\vanessa\reports
VANESSA_MCP_PORT=9880
VANESSA_TC_PORT=1539
# Windows-пользователь отдельной RDP-сессии, где живут окна TM/TC (не console пользователя)
VANESSA_RDP_USER=vanessa
# Задача планировщика, которая запускает TM/TC внутри RDP-сессии (создает register-launch-task.ps1)
VANESSA_LAUNCH_TASK=myprojWtsLaunchVanessa

# --- MCP ---
# Хост общих MCP и индексатора: 127.0.0.1 на одной машине; MCP-сервер из реестра — в контуре команды (docs/10).
# Используют doctor.ps1, mcp_http.py (адрес портом), syntaxcheck_file.py, validate_form_file.py. Граф — GRAPH_URL.
MCP_HOST=127.0.0.1
CODE_INDEX_CONTAINER=myproj_code_index
CODE_INDEX_IMAGE=myproj-code-index:1.8.5
CODE_INDEX_PORT=8061
GRAPH_URL=http://127.0.0.1:8006/mcp/
GRAPH_PROJECT_CONF=MyprojConf
GRAPH_PROJECT_EXT=MyprojExt

# --- Git (локальный автор коммитов) ---
GIT_AUTHOR=chubajs12
GIT_EMAIL=chubajs12@myproj.local
