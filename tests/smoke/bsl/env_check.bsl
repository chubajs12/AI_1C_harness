// Дымовая проверка базы через MCP 1С: конфигурация, расширения (наше активно, служебные для Vanessa на месте,
// расширения MCP 1С - активны и без безопасного режима). Шаг run_steps.py вида ob/check: PASS, если Результат.ok = Истина.
УстановитьПривилегированныйРежим(Истина);
Результат = Новый Структура("ok, ошибки, конфигурация, версия, расширения", Ложь, Новый Массив, Метаданные.Имя,
	Метаданные.Версия, Новый Массив);
Нужны = Новый Соответствие;
Нужны.Вставить("client_mcp", Ложь);
Нужны.Вставить("VAExtension", Ложь);
Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
	Результат.расширения.Добавить(Новый Структура("имя, версия, активно, безопасныйРежим",
		Расширение.Имя, Расширение.Версия, Расширение.Активно, Расширение.БезопасныйРежим));
	Если Нужны.Получить(Расширение.Имя) <> Неопределено Тогда
		Нужны.Вставить(Расширение.Имя, Расширение.Активно);
	КонецЕсли;
	Если СтрНачинаетсяС(Расширение.Имя, "MCP_") И (Не Расширение.Активно Или Расширение.БезопасныйРежим <> Ложь) Тогда
		Результат.ошибки.Добавить("расширение " + Расширение.Имя
			+ " неактивно или в безопасном режиме - переустановить install-mcp.ps1 (docs/03)");
	КонецЕсли;
КонецЦикла;
Для Каждого КлючИЗначение Из Нужны Цикл
	Если Не КлючИЗначение.Значение Тогда
		Результат.ошибки.Добавить("нет активного расширения " + КлючИЗначение.Ключ);
	КонецЕсли;
КонецЦикла;
Результат.ok = Результат.ошибки.Количество() = 0;
