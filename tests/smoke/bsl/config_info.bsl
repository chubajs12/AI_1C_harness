// Что за конфигурация в базе проекта (для паспорта в AGENTS.md): имя, версия, поставщик, режим совместимости,
// БСП и ее версия, расширения, объем. Только чтение. Шаг run_steps.py вида ob (ok = Истина всегда, если выполнилось).
УстановитьПривилегированныйРежим(Истина);
Результат = Новый Структура;
Результат.Вставить("ok", Истина);
Результат.Вставить("имя", Метаданные.Имя);
Результат.Вставить("синоним", Метаданные.Синоним);
Результат.Вставить("версия", Метаданные.Версия);
Результат.Вставить("поставщик", Метаданные.Поставщик);
Результат.Вставить("режимСовместимости", Строка(Метаданные.РежимСовместимости));
Результат.Вставить("режимСовместимостиРасширений", Строка(Метаданные.РежимСовместимостиРасширенияКонфигурации));
Результат.Вставить("вариантЯзыка", Строка(Метаданные.ВариантВстроенногоЯзыка));
Результат.Вставить("основнойРежимЗапуска", Строка(Метаданные.ОсновнойРежимЗапуска));
СистемнаяИнформация = Новый СистемнаяИнформация;
Результат.Вставить("версияПлатформы", СистемнаяИнформация.ВерсияПриложения);

// БСП: есть ли и какой версии (обращение через Вычислить в Попытке: в самописной конфигурации модуля нет)
ЕстьБСП = Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыСервер") <> Неопределено;
ВерсияБСП = "";
Если ЕстьБСП Тогда
	Попытка
		ВерсияБСП = Вычислить("СтандартныеПодсистемыСервер.ВерсияБиблиотеки()");
	Исключение
		ВерсияБСП = "не определена";
	КонецПопытки;
КонецЕсли;
Результат.Вставить("бсп", ЕстьБСП);
Результат.Вставить("версияБСП", ВерсияБСП);

Объем = Новый Структура;
Объем.Вставить("справочники", Метаданные.Справочники.Количество());
Объем.Вставить("документы", Метаданные.Документы.Количество());
Объем.Вставить("регистрыСведений", Метаданные.РегистрыСведений.Количество());
Объем.Вставить("регистрыНакопления", Метаданные.РегистрыНакопления.Количество());
Объем.Вставить("общиеМодули", Метаданные.ОбщиеМодули.Количество());
Объем.Вставить("подсистемы", Метаданные.Подсистемы.Количество());
Результат.Вставить("объем", Объем);

Расширения = Новый Массив;
Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
	Описание = Расширение.Имя + " " + Расширение.Версия;
	Если Не Расширение.Активно Тогда
		Описание = Описание + " (не активно)";
	КонецЕсли;
	Расширения.Добавить(Описание);
КонецЦикла;
Результат.Вставить("расширения", Расширения);
