// ШАБЛОН проверки данных после шага UI (MCP 1С execute_code, шаг run_steps.py вида check, &ЭТАП подставляет раннер).
// Проверять фактическое состояние (статусы, количество строк, движения), а не "ошибки не было".
// Табличные части и связанные данные читать ЗАПРОСАМИ: чтение "через точку" от ссылки берет данные из кэша сеанса
// публикации MCP 1С (до ~20 с при reuseSessions=autouse) и дает ложное расхождение сразу после
// действия в интерфейсе (урок Energy, docs/03 п. 7).
УстановитьПривилегированныйРежим(Истина);
Этап = "&ЭТАП"; // раннер подставляет stage шага
Результат = Новый Структура("ok, этап, факты, ошибки", Ложь, Этап, Новый Структура, Новый Массив);

Запрос = Новый Запрос(
"ВЫБРАТЬ
|	КОЛИЧЕСТВО(Т.Ссылка) КАК Количество
|ИЗ
|	Документ.ИмяДокумента КАК Т
|ГДЕ
|	Т.Комментарий ПОДОБНО &П
|	И Т.Проведен");
Запрос.УстановитьПараметр("П", "ТЕСТ %");
Выборка = Запрос.Выполнить().Выбрать();
Выборка.Следующий();
Результат.факты.Вставить("проведено", Выборка.Количество);

Если Этап = "after_post" И Результат.факты.проведено <> 1 Тогда
	Результат.ошибки.Добавить("ожидался 1 проведенный документ, найдено " + Результат.факты.проведено);
КонецЕсли;

Результат.ok = Результат.ошибки.Количество() = 0;
