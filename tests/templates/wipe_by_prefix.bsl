// ШАБЛОН вайпа тестовых данных по префиксу (MCP 1С execute_code, шаг run_steps.py вида ob).
// Заполнить ПАРАМЕТРЫ, прогнать с Пробный = Истина (что будет удалено), затем Ложь.
// Принцип Energy: все тестовые данные несут префикс в наименовании/комментарии ("ТЕСТ <блок> ..."), вайп удаляет
// документы (с движениями) и элементы справочников по префиксу; чужие данные не трогает. Сначала документы и ссылки
// на удаляемое (иначе остатки ломают следующий прогон), потом справочники. Вайп - перед каждым полным прогоном.
// Удаление - Объект.Удалить() в режиме загрузки (без проверок и подписок): только тестовые данные тестовой базы.
// syntax-checker дает QueryParseError на фрагментах динамического текста запроса - ожидаемо; сам запрос
// проверен на живой базе (псевдоним вложенного запроса - не "В": зарезервированное слово).

// --- ПАРАМЕТРЫ ---
Префикс = "ТЕСТ ";
Пробный = Истина;
ВидыДокументов = СтрРазделить("", ",", Ложь);   // документы с реквизитом Комментарий: "ЗаказКлиента,Реализация..."
ВидыСправочников = СтрРазделить("", ",", Ложь); // справочники: "Контрагенты,Номенклатура"
// -----------------

УстановитьПривилегированныйРежим(Истина);
Результат = Новый Структура("ok, пробный, удалено, ошибки", Ложь, Пробный, Новый Массив, Новый Массив);

// один пакетный запрос: документы (порядок 1), затем справочники (порядок 2)
Части = Новый Массив;
Для Каждого Имя Из ВидыДокументов Цикл
	МД = Метаданные.Документы.Найти(СокрЛП(Имя));
	Если МД = Неопределено Или МД.Реквизиты.Найти("Комментарий") = Неопределено Тогда
		Результат.ошибки.Добавить("нет документа с реквизитом Комментарий: " + Имя);
		Продолжить;
	КонецЕсли;
	Части.Добавить("ВЫБРАТЬ Т.Ссылка КАК Ссылка, 1 КАК Порядок ИЗ Документ." + МД.Имя
		+ " КАК Т ГДЕ Т.Комментарий ПОДОБНО &П");
КонецЦикла;
Для Каждого Имя Из ВидыСправочников Цикл
	МД = Метаданные.Справочники.Найти(СокрЛП(Имя));
	Если МД = Неопределено Тогда
		Результат.ошибки.Добавить("нет справочника " + Имя);
		Продолжить;
	КонецЕсли;
	Части.Добавить("ВЫБРАТЬ Т.Ссылка, 2 ИЗ Справочник." + МД.Имя + " КАК Т ГДЕ Т.Наименование ПОДОБНО &П");
КонецЦикла;

Если Части.Количество() > 0 Тогда
	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ (" + СтрСоединить(Части, " ОБЪЕДИНИТЬ ВСЕ ") + ") КАК Данные УПОРЯДОЧИТЬ ПО Данные.Порядок");
	Запрос.УстановитьПараметр("П", Префикс + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.удалено.Добавить(Строка(ТипЗнч(Выборка.Ссылка)) + ": " + Строка(Выборка.Ссылка));
		Если Пробный Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Удалить(); // движения документа удаляются вместе с ним
		Исключение
			Текст = Строка(Выборка.Ссылка) + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("Тесты.Вайп", УровеньЖурналаРегистрации.Ошибка, , , Текст);
			Результат.ошибки.Добавить(Текст);
		КонецПопытки;
	КонецЦикла;
КонецЕсли;

Результат.ok = Результат.ошибки.Количество() = 0;
